[Desktop Entry]
Type=Application
Name=CaramOS Theme Applier
Comment=Áp dụng giao diện CaramOS chuẩn ở lần đăng nhập đầu tiên
Exec=/usr/local/bin/caramos-ui apply-theme
AutostartCondition=unless-exists .config/caramos-theme-applied
X-GNOME-Autostart-Phase=Desktop
NoDisplay=true
OnlyShowIn=X-Cinnamon;
